{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hana",
  "version": "0.1.0",
  "identifier": "online.hanamanga.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/desktop-prepare.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": ["server/**/*"]
  }
}