# Canonical origin used for metadata, sitemap, and robots.txt.
# Optional on Vercel — in production it falls back to https://hanamanga.online.
# Set this in Vercel project settings if you want to override it.
NEXT_PUBLIC_SITE_URL=https://hanamanga.online

# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Integration OAuth clients (create in each service's developer portal)
# AniList: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# MyAnimeList: https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
